{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc-filter.local/schemas/structured-output-1.0.0.json",
  "title": "Detailed AIGC and filter detection output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "prediction", "confidence",
    "suspicious_regions", "artifact_types", "explanation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "prediction": {
      "type": "string",
      "enum": ["real", "fake", "filter_processed"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "suspicious_regions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["forehead", "left_eye", "right_eye", "nose", "left_cheek", "right_cheek", "mouth", "jaw"]
      }
    },
    "artifact_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "eye_enlarging", "face_reshaping", "over_smoothing", "whitening"
        ]
      }
    },
    "explanation": { "type": "string", "minLength": 1 }
  }
}
