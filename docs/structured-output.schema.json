{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc-filter.local/schemas/structured-output-1.0.0.json",
  "title": "Detailed AIGC and filter detection output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "prediction", "confidence", "retouching",
    "suspicious_regions", "artifact_types", "explanation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "prediction": {
      "type": "string",
      "enum": ["real", "fake", "filter_processed"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "retouching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eye_enlarging", "face_lifting", "skin_smoothing", "face_whitening"
      ],
      "properties": {
        "eye_enlarging": { "$ref": "#/$defs/operation" },
        "face_lifting": { "$ref": "#/$defs/operation" },
        "skin_smoothing": { "$ref": "#/$defs/operation" },
        "face_whitening": { "$ref": "#/$defs/operation" }
      }
    },
    "suspicious_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" }
    },
    "artifact_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "eye_enlarging", "face_lifting", "skin_smoothing", "face_whitening"
        ]
      }
    },
    "explanation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "level_name", "confidence"],
      "properties": {
        "level": { "type": "integer", "enum": [0, 30, 60, 90] },
        "level_name": {
          "type": "string",
          "enum": ["off", "slight", "medium", "heavy"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": 0 } } },
          "then": { "properties": { "level_name": { "const": "off" } } }
        },
        {
          "if": { "properties": { "level": { "const": 30 } } },
          "then": { "properties": { "level_name": { "const": "slight" } } }
        },
        {
          "if": { "properties": { "level": { "const": 60 } } },
          "then": { "properties": { "level_name": { "const": "medium" } } }
        },
        {
          "if": { "properties": { "level": { "const": 90 } } },
          "then": { "properties": { "level_name": { "const": "heavy" } } }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "confidence"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
